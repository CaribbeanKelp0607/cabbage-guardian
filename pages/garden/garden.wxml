<view class="page garden-page">
  <view class="eyebrow">完成任务，亲手种下一颗菜</view>
  <view class="garden-title-row">
    <view class="title">我的快乐菜园</view>
    <view class="total-pill">{{total}} 颗蔬菜</view>
  </view>

  <view class="garden-scene">
    <image class="garden-background" src="/assets/garden/garden-background.jpg" mode="widthFix" />
    <view style="{{bearPositionStyle}}">
      <image src="/assets/garden/bear-patrol.png" mode="aspectFit" style="{{bearBodyStyle}};display:block;width:177rpx;height:177rpx;filter:drop-shadow(0 9rpx 7rpx rgba(65,53,30,.2));" />
      <view style="position:absolute;left:50%;top:-34rpx;transform:translateX(-50%);white-space:nowrap;background:rgba(255,248,224,.96);border-radius:999rpx;padding:6rpx 13rpx;color:#7c6034;font-size:19rpx;font-weight:800;">{{bearMessage}}</view>
      <view style="position:absolute;left:22rpx;top:160rpx;color:#8b7650;font-size:17rpx;letter-spacing:8rpx;white-space:nowrap;">· · ·</view>
    </view>
    <view class="plot-grid">
      <view class="vegetable-plot" wx:for="{{plots}}" wx:key="type">
        <view class="vegetable-items">
          <text class="vegetable" wx:for="{{item.items}}" wx:for-item="plantItem" wx:key="index">{{item.emoji}}</text>
        </view>
        <view wx:if="{{item.count}}" class="plot-count">{{item.name}} × {{item.count}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{role === 'child' && pendingPlants > 0}}" class="reward-card">
    <view class="reward-title">你有 {{pendingPlants}} 颗蔬菜可以种</view>
    <view class="reward-hint">选择喜欢的蔬菜，它会马上出现在菜地里</view>
    <view class="vegetable-choices">
      <button
        wx:for="{{plots}}"
        wx:key="type"
        class="vegetable-choice"
        data-type="{{item.type}}"
        bindtap="plant"
        disabled="{{planting}}"
      >
        <text class="choice-emoji">{{item.emoji}}</text>
        <text>{{item.name}}</text>
      </button>
    </view>
  </view>

  <view wx:elif="{{role === 'child'}}" class="empty-reward">完成一次打卡任务，就可以选择种下一颗蔬菜。</view>
  <view wx:else class="empty-reward">孩子完成任务后，可以在这里选择并种下蔬菜。</view>

  <view class="bear-card">
    <image src="/assets/garden/bear-patrol.png" mode="aspectFit" style="width:76rpx;height:76rpx;flex-shrink:0;" />
    <view>
      <view class="bear-title">小熊正在菜地里巡逻</view>
      <view class="bear-text">它会伸着大爪子找菜；如果今天还有任务没有完成，晚上 23:00 它会随机偷走一颗已经种下的菜。</view>
    </view>
  </view>
</view>
