.garden-page{padding-top:34rpx}.garden-title-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.total-pill{flex:0 0 auto;background:#e7f4d8;color:#4b8c3f;border-radius:999rpx;padding:10rpx 20rpx;font-size:25rpx;font-weight:800}.garden-scene{position:relative;margin-top:24rpx;border-radius:32rpx;overflow:hidden;box-shadow:0 14rpx 34rpx rgba(55,102,51,.16)}.garden-background{display:block;width:100%}.plot-grid{position:absolute;left:4.5%;right:4.5%;top:53.5%;bottom:10.5%;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(2,1fr);column-gap:5%;row-gap:5%}.vegetable-plot{position:relative;display:flex;align-items:center;justify-content:center;min-width:0}.vegetable-items{display:grid;grid-template-columns:repeat(3,1fr);place-items:center;width:76%;height:70%}.vegetable{font-size:30rpx;line-height:1}.plot-count{position:absolute;left:50%;bottom:-4rpx;transform:translateX(-50%);white-space:nowrap;background:rgba(255,255,255,.88);color:#44573f;border-radius:999rpx;padding:3rpx 10rpx;font-size:18rpx;font-weight:800}.reward-card{background:#fff;border-radius:28rpx;padding:28rpx;margin-top:24rpx;box-shadow:0 8rpx 24rpx rgba(87,115,69,.08)}.reward-title{font-size:31rpx;font-weight:900;color:#344137}.reward-hint{font-size:24rpx;color:#7d877a;margin-top:7rpx}.vegetable-choices{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:22rpx}.vegetable-choice{display:flex;flex-direction:column;align-items:center;justify-content:center;margin:0;padding:14rpx 6rpx;line-height:1.4;background:#edf6e7;color:#4e7548;border-radius:20rpx;font-size:23rpx}.vegetable-choice:after{border:0}.choice-emoji{font-size:42rpx;margin-bottom:5rpx}.empty-reward{background:#fff;border-radius:22rpx;padding:22rpx;margin-top:24rpx;text-align:center;color:#768174;font-size:25rpx}.bear-card{display:flex;align-items:center;gap:18rpx;background:#fff0cf;border-radius:24rpx;padding:23rpx;margin:22rpx 0}.bear-icon{font-size:50rpx}.bear-title{font-size:27rpx;font-weight:900;color:#6d572c}.bear-text{font-size:23rpx;color:#806d45;line-height:1.55;margin-top:5rpx}
