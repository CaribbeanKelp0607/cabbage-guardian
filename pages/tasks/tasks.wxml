<view class="page task-page">
  <view class="eyebrow">爸爸妈妈的工具</view>
  <view class="title">{{role==='child'?'今日任务':'管理今日任务'}}</view>

  <block wx:if="{{role==='father'||role==='mother'}}">
    <view class="card editor">
      <view class="editor-title">{{editingId?'修改任务':'新增任务'}}</view>
      <input placeholder="例如：阅读 20 分钟" value="{{title}}" data-k="title" bindinput="i"/>
      <textarea placeholder="学习要求（可选）" value="{{detail}}" data-k="detail" bindinput="i"/>
      <view class="muted">同名任务当天不会重复创建；打卡后不可修改或删除。</view>
      <view class="form-actions">
        <button wx:if="{{editingId}}" class="secondary-button" bindtap="cancelEdit" disabled="{{saving}}">取消</button>
        <button class="button save-button" bindtap="save" disabled="{{saving}}" loading="{{saving}}">{{saving?'保存中':editingId?'保存修改':'新增任务'}}</button>
      </view>
    </view>

    <view class="list-title">今日任务 · {{tasks.length}}</view>
    <view wx:if="{{tasks.length===0}}" class="empty-card">今天还没有任务，可以从上方新增。</view>
    <view class="manage-card" wx:for="{{tasks}}" wx:key="id">
      <view class="manage-row" bindtap="showTaskDetail" data-id="{{item.id}}">
        <view class="number">{{index+1}}</view>
        <view class="manage-copy">
          <view class="manage-title">{{item.title}}</view>
          <view class="muted detail">{{item.detail}}</view>
          <view class="detail-entry">查看详情 ›</view>
        </view>
        <text class="state {{item.status}}">{{item.status==='todo'?'待打卡':item.status==='submitted'?'待确认':'已完成'}}</text>
      </view>
      <view wx:if="{{item.status==='todo'}}" class="item-actions">
        <button class="edit-button" bindtap="edit" data-id="{{item.id}}">编辑</button>
        <button class="delete-button" bindtap="remove" data-id="{{item.id}}" loading="{{deletingId===item.id}}" disabled="{{deletingId!==''}}">删除</button>
      </view>
      <view wx:elif="{{item.status==='submitted'}}" class="pending-actions">
        <button class="confirm-task-button" bindtap="confirmTask" data-id="{{item.id}}" loading="{{confirmingId===item.id}}" disabled="{{confirmingId!==''}}">确认并奖励白菜</button>
      </view>
      <view wx:else class="locked">已确认任务不可修改或删除</view>
    </view>
  </block>

  <block wx:else>
    <view class="card child-note">
      任务由爸爸或妈妈管理，完成任务请前往“今天”打卡。
      <button class="button" bindtap="goHome">前往今日打卡</button>
    </view>
    <view class="manage-card" wx:for="{{tasks}}" wx:key="id">
      <view class="manage-row" bindtap="showTaskDetail" data-id="{{item.id}}">
        <view class="number">{{index+1}}</view>
        <view class="manage-copy">
          <view class="manage-title">{{item.title}}</view>
          <view class="muted detail">{{item.detail}}</view>
          <view class="detail-entry">查看详情 ›</view>
        </view>
        <text class="state {{item.status}}">{{item.status==='todo'?'待打卡':item.status==='submitted'?'待确认':'已完成'}}</text>
      </view>
    </view>
  </block>

  <task-detail visible="{{detailVisible}}" task="{{detailTask}}" bindclose="closeTaskDetail"/>
</view>
