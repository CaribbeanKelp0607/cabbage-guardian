.task-page{padding-top:38rpx}.editor{margin-top:30rpx}.editor-title,.list-title{font-size:32rpx;font-weight:900;color:#344137}.list-title{margin:38rpx 4rpx 18rpx}input,textarea{box-sizing:border-box;display:block;width:100%;background:#f5f7f1;border-radius:18rpx;margin:18rpx 0;font-size:30rpx}input{height:96rpx;padding:0 26rpx;line-height:96rpx}textarea{height:160rpx;padding:24rpx 26rpx}.form-actions{display:flex;gap:18rpx;margin-top:24rpx}.form-actions button{margin:0}.save-button{flex:1}.secondary-button{width:180rpx;background:#edf2e9;color:#61705f;border-radius:999rpx;font-size:28rpx;font-weight:700}.secondary-button:after,.edit-button:after,.delete-button:after{border:0}.manage-card{background:#fff;border-radius:25rpx;padding:25rpx;margin:18rpx 0;box-shadow:0 8rpx 24rpx rgba(87,115,69,.08)}.manage-row{display:flex;align-items:center;gap:18rpx}.number{flex:0 0 auto;width:58rpx;height:58rpx;border-radius:18rpx;background:#e7f3df;color:#57984c;display:flex;align-items:center;justify-content:center;font-weight:900}.manage-copy{min-width:0;flex:1}.manage-title{font-size:30rpx;font-weight:800}.detail{margin-top:7rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.state{font-size:22rpx;padding:8rpx 12rpx;border-radius:999rpx}.state.todo{color:#58984b;background:#e1f2d1}.state.submitted{color:#af7a20;background:#fff0c8}.state.done{color:#367d65;background:#ddf1e9}.item-actions{display:flex;justify-content:flex-end;gap:16rpx;margin-top:22rpx}.item-actions button{width:140rpx;margin:0;font-size:25rpx;line-height:2.2;border-radius:999rpx}.edit-button{background:#e6f2e1;color:#4d8d43}.delete-button{background:#fff0ed;color:#b95247}.locked{text-align:right;color:#9a9e94;font-size:23rpx;margin-top:18rpx}.empty-card,.child-note{background:#fff;border-radius:25rpx;padding:34rpx;color:#7c806b;text-align:center}.child-note button{margin-top:28rpx}
.pending-actions{margin-top:22rpx}.confirm-task-button{margin:0;background:#d59a31;color:#fff;border-radius:999rpx;font-size:27rpx;font-weight:800}.confirm-task-button:after{border:0}
.detail-entry{display:inline-block;color:#4d917d;font-size:22rpx;margin-top:8rpx}
.resource-button{margin:18rpx 0 0;background:#e5f2df;color:#4d8d43;border-radius:999rpx;font-size:25rpx}.resource-button:after{border:0}
