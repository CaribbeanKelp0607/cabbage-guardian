<view class="page dashboard"><view class="date">{{dateLabel}}</view><view class="welcome">{{role==='child'?'今天也要认真完成任务哦':'查看孩子今天的打卡情况'}}</view><view class="summary"><view class="metric"><view class="metric-icon progress-icon">✓</view><view><view class="metric-label">今日进度</view><view class="metric-value">{{completedTasks}}/{{totalTasks}}</view></view></view><view class="metric"><view class="metric-icon reward-icon">🥬</view><view><view class="metric-label">今日收获</view><view class="metric-value reward">+{{earnedToday}} 颗</view></view></view><view class="progress-track"><view class="progress-fill" style="width:{{progressPercent}}%"></view></view><view class="garden-line"><text>菜地共有 {{cabbages}} 颗白菜</text><text>连续 {{streak}} 天</text></view></view><view class="section-head"><view><view class="section-title">今日打卡任务</view><view class="section-sub">完成一项，收获一颗白菜</view></view><view class="task-count">{{completedTasks}} / {{totalTasks}}</view></view><view wx:if="{{ready&&tasks.length===0}}" class="empty"><view class="empty-icon">🌱</view><view class="empty-title">今天还没有任务</view><view class="muted">爸爸妈妈可以前往“任务”页添加</view></view><view class="task-card" wx:for="{{tasks}}" wx:key="id"><view class="task-main"><view class="task-mark {{item.status==='done'?'done-mark':item.status==='submitted'?'pending-mark':''}}">{{item.status==='done'?'✓':index+1}}</view><view class="task-copy"><view class="task-title">{{item.title}}</view><view class="task-detail">{{item.detail}}</view></view><view class="status {{item.status}}">{{item.status==='todo'?'待打卡':item.status==='submitted'?'待确认':'已完成 +1'}}</view></view><button wx:if="{{role==='child'&&item.status==='todo'}}" class="checkin-button" bindtap="submit" data-id="{{item.id}}" loading="{{submittingId===item.id}}" disabled="{{submittingId!==''}}">打卡</button><button wx:if="{{role!=='child'&&item.status==='submitted'}}" class="checkin-button confirm-button" bindtap="confirm" data-id="{{item.id}}" loading="{{confirmingId===item.id}}" disabled="{{confirmingId!==''}}">确认旧打卡</button></view><view class="tip">🐻 21:00 若还有未完成任务，小熊只会偷走一颗白菜。明天再一起赢回来！</view></view>
