.dashboard{padding-top:42rpx}.date{font-size:52rpx;line-height:1.2;font-weight:900;color:#28382c;letter-spacing:1rpx}.welcome{margin-top:12rpx;color:#7c806b;font-size:27rpx}.summary{display:flex;flex-wrap:wrap;background:#fff;border-radius:32rpx;padding:28rpx;margin:34rpx 0 24rpx;box-shadow:0 12rpx 32rpx rgba(87,115,69,.1)}.metric{box-sizing:border-box;width:50%;display:flex;align-items:center;gap:18rpx}.metric-icon{width:76rpx;height:76rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;font-size:36rpx;font-weight:900}.progress-icon{color:#408f79;background:#e6f5ef}.reward-icon{background:#fff4d8}.metric-label{font-size:25rpx;color:#7c806b}.metric-value{font-size:39rpx;font-weight:900;margin-top:4rpx}.metric-value.reward{color:#d79a2d}.progress-track{width:100%;height:12rpx;background:#edf2e9;border-radius:999rpx;margin-top:28rpx;overflow:hidden}.progress-fill{height:100%;background:linear-gradient(90deg,#68b45b,#368e73);border-radius:999rpx;transition:width .25s}.garden-line{width:100%;display:flex;justify-content:space-between;color:#7c806b;font-size:24rpx;margin-top:18rpx}.week-card{display:flex;align-items:stretch;background:#fff;border-radius:30rpx;padding:20rpx 10rpx;box-shadow:0 9rpx 28rpx rgba(87,115,69,.09)}.week-nav{width:42rpx;display:flex;align-items:center;justify-content:center;color:#4f8f78;font-size:45rpx;font-weight:300}.week-nav.disabled{color:#d2d7cf}.day-item{position:relative;flex:1;min-width:0;text-align:center;border-radius:24rpx;padding:14rpx 0 20rpx;color:#59665b}.week-name{font-size:21rpx;white-space:nowrap}.day-number{font-size:29rpx;font-weight:800;margin-top:12rpx}.day-item.selected{color:#fff;background:#4d9a83;box-shadow:0 8rpx 18rpx rgba(56,132,108,.24)}.day-item.future{color:#c8cdc5}.today-dot{position:absolute;bottom:8rpx;left:50%;width:7rpx;height:7rpx;border-radius:50%;background:#4d9a83;transform:translateX(-50%)}.day-item.selected .today-dot{background:#fff}.section-head{display:flex;align-items:flex-end;justify-content:space-between;margin:38rpx 2rpx 20rpx}.section-title{font-size:38rpx;font-weight:900}.section-sub{font-size:24rpx;color:#8a907e;margin-top:8rpx}.task-count{color:#4e8b42;font-weight:800;background:#e8f6d5;padding:10rpx 18rpx;border-radius:999rpx}.task-card{background:#fff;border-radius:28rpx;padding:26rpx;margin:20rpx 0;box-shadow:0 9rpx 26rpx rgba(87,115,69,.08)}.task-main{display:flex;align-items:center;gap:20rpx}.task-mark{flex:0 0 auto;width:70rpx;height:70rpx;border-radius:22rpx;background:#e9f4e4;color:#549747;font-size:30rpx;font-weight:900;display:flex;align-items:center;justify-content:center}.done-mark{background:#4f9b78;color:#fff}.pending-mark{background:#fff1cc;color:#c28b29}.task-copy{min-width:0;flex:1}.task-title{font-size:31rpx;font-weight:800;color:#2f3d32}.task-detail{font-size:25rpx;color:#858b7c;margin-top:8rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.status{flex:0 0 auto;font-size:22rpx;padding:8rpx 13rpx;border-radius:999rpx}.status.todo{color:#58984b;background:#e1f2d1}.status.submitted{color:#af7a20;background:#fff0c8}.status.done{color:#367d65;background:#ddf1e9}.checkin-button{display:block;width:280rpx;line-height:64rpx;margin:16rpx auto 0;background:#438f78;color:#fff;border-radius:999rpx;font-size:26rpx;font-weight:800}.checkin-button[disabled]{background:#b6c7bd;color:#fff}.evidence-panel{margin-top:22rpx;background:#f5f9f2;border-radius:20rpx;padding:18rpx}.evidence-hint{font-size:23rpx;color:#667664}.evidence-actions{display:flex;gap:12rpx;margin-top:15rpx}.evidence-button{flex:1;margin:0;line-height:58rpx;font-size:24rpx;background:#e3f0de;color:#4d8d43;border-radius:999rpx}.evidence-button.recording{background:#ffe6e1;color:#b6564b}.evidence-button:after{border:0}.uploading-hint{font-size:22rpx;color:#668071;margin-top:12rpx;text-align:center}.empty{text-align:center;background:#fff;border-radius:28rpx;padding:58rpx 24rpx;margin:20rpx 0}.empty-icon{font-size:64rpx}.empty-title{font-size:31rpx;font-weight:800;margin:16rpx 0 8rpx}.tip{background:#fff0c9;padding:24rpx;border-radius:20rpx;color:#786331;font-size:26rpx;margin-top:28rpx}.history-tip{background:#eef3eb;padding:22rpx;border-radius:20rpx;color:#737e71;font-size:25rpx;text-align:center;margin-top:28rpx}
