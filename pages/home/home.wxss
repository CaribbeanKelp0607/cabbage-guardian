.top,.row{display:flex;justify-content:space-between;align-items:center}.top{background:#e8f6d5;font-size:34rpx;font-weight:bold}.small{font-size:32rpx}.row{align-items:flex-start;margin-bottom:22rpx}.task{font-size:31rpx;font-weight:bold;margin-bottom:8rpx}.status{font-size:23rpx;color:#4e8b42;background:#dff0c8;padding:8rpx;border-radius:16rpx}.tip{background:#fff0c9;padding:24rpx;border-radius:20rpx;color:#786331;font-size:26rpx}
