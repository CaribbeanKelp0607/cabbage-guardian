.dashboard{padding-top:42rpx}.date{font-size:52rpx;line-height:1.2;font-weight:900;color:#28382c;letter-spacing:1rpx}.welcome{margin-top:12rpx;color:#7c806b;font-size:27rpx}.summary{display:flex;flex-wrap:wrap;background:#fff;border-radius:32rpx;padding:28rpx;margin:34rpx 0;box-shadow:0 12rpx 32rpx rgba(87,115,69,.1)}.metric{box-sizing:border-box;width:50%;display:flex;align-items:center;gap:18rpx}.metric-icon{width:76rpx;height:76rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;font-size:36rpx;font-weight:900}.progress-icon{color:#408f79;background:#e6f5ef}.reward-icon{background:#fff4d8}.metric-label{font-size:25rpx;color:#7c806b}.metric-value{font-size:39rpx;font-weight:900;margin-top:4rpx}.metric-value.reward{color:#d79a2d}.progress-track{width:100%;height:12rpx;background:#edf2e9;border-radius:999rpx;margin-top:28rpx;overflow:hidden}.progress-fill{height:100%;background:linear-gradient(90deg,#68b45b,#368e73);border-radius:999rpx;transition:width .25s}.garden-line{width:100%;display:flex;justify-content:space-between;color:#7c806b;font-size:24rpx;margin-top:18rpx}.section-head{display:flex;align-items:flex-end;justify-content:space-between;margin:38rpx 2rpx 20rpx}.section-title{font-size:38rpx;font-weight:900}.section-sub{font-size:24rpx;color:#8a907e;margin-top:8rpx}.task-count{color:#4e8b42;font-weight:800;background:#e8f6d5;padding:10rpx 18rpx;border-radius:999rpx}.task-card{background:#fff;border-radius:28rpx;padding:26rpx;margin:20rpx 0;box-shadow:0 9rpx 26rpx rgba(87,115,69,.08)}.task-main{display:flex;align-items:center;gap:20rpx}.task-mark{flex:0 0 auto;width:70rpx;height:70rpx;border-radius:22rpx;background:#e9f4e4;color:#549747;font-size:30rpx;font-weight:900;display:flex;align-items:center;justify-content:center}.done-mark{background:#4f9b78;color:#fff}.pending-mark{background:#fff1cc;color:#c28b29}.task-copy{min-width:0;flex:1}.task-title{font-size:31rpx;font-weight:800;color:#2f3d32}.task-detail{font-size:25rpx;color:#858b7c;margin-top:8rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.status{flex:0 0 auto;font-size:22rpx;padding:8rpx 13rpx;border-radius:999rpx}.status.todo{color:#58984b;background:#e1f2d1}.status.submitted{color:#af7a20;background:#fff0c8}.status.done{color:#367d65;background:#ddf1e9}.checkin-button{margin:24rpx 0 0;background:#438f78;color:#fff;border-radius:999rpx;font-size:28rpx;font-weight:800}.confirm-button{background:#d59a31}.empty{text-align:center;background:#fff;border-radius:28rpx;padding:58rpx 24rpx;margin:20rpx 0}.empty-icon{font-size:64rpx}.empty-title{font-size:31rpx;font-weight:800;margin:16rpx 0 8rpx}.tip{background:#fff0c9;padding:24rpx;border-radius:20rpx;color:#786331;font-size:26rpx;margin-top:28rpx}
