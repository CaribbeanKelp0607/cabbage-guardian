.resource-page{padding-top:38rpx}.intro{font-size:27rpx;color:#778175;line-height:1.7;margin:16rpx 0 28rpx}.resource-card{display:flex;align-items:center;gap:20rpx;background:#fff;border-radius:28rpx;padding:24rpx;margin:18rpx 0;box-shadow:0 8rpx 24rpx rgba(87,115,69,.08)}.resource-icon{flex:0 0 auto;width:70rpx;height:70rpx;border-radius:22rpx;background:#e8f3df;color:#4d9847;display:flex;align-items:center;justify-content:center;font-size:32rpx;font-weight:900}.resource-copy{flex:1;min-width:0}.resource-title{font-size:32rpx;font-weight:900}.resource-meta{font-size:23rpx;color:#7d877a;margin-top:7rpx}.resource-preview{font-size:23rpx;color:#9aa194;margin-top:10rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.resource-arrow{font-size:42rpx;color:#6ea38e}.empty-resource{text-align:center;background:#fff;border-radius:28rpx;padding:58rpx 26rpx}.empty-icon{font-size:66rpx}.empty-title{font-size:31rpx;font-weight:900;margin:16rpx 0 8rpx}.empty-resource button{margin-top:28rpx}.waiting{margin-top:26rpx;font-size:25rpx;color:#818a7c}.resource-mask{position:fixed;z-index:1100;inset:0;background:rgba(29,41,32,.48);display:flex;align-items:center;justify-content:center;padding:36rpx}.resource-dialog{box-sizing:border-box;width:100%;max-height:84vh;overflow:auto;background:#fff;border-radius:32rpx;padding:34rpx}.dialog-top{display:flex;align-items:flex-start;justify-content:space-between;gap:22rpx}.dialog-title{font-size:40rpx;font-weight:900}.dialog-meta{font-size:25rpx;color:#7d877a;margin-top:9rpx}.dialog-close{width:58rpx;height:58rpx;border-radius:50%;background:#edf3e9;color:#657064;font-size:42rpx;line-height:54rpx;text-align:center}.poem-text{white-space:pre-wrap;text-align:center;background:#f6f9f3;border-radius:22rpx;padding:30rpx 22rpx;margin:28rpx 0;font-size:31rpx;line-height:2;color:#354235}.template-area{border-top:1rpx solid #edf0e9;padding-top:24rpx}.template-title{font-size:28rpx;font-weight:800}.template-buttons{display:flex;gap:14rpx;margin-top:18rpx}.template-button{flex:1;margin:0;background:#4d9a83;color:#fff;border-radius:999rpx;font-size:26rpx}.template-button:after{border:0}.child-read{color:#7d877a;font-size:26rpx;text-align:center;margin-top:18rpx}
