.resource-page{padding-top:28rpx}.library-tabs{display:flex;gap:14rpx;margin:0 0 26rpx}.library-tab{flex:1;text-align:center;padding:16rpx;border-radius:18rpx;background:#eef2eb;color:#738070;font-size:27rpx;font-weight:700}.library-tab.active{background:#4d9a83;color:#fff}.intro{font-size:27rpx;color:#778175;line-height:1.7;margin:16rpx 0 18rpx}.resource-tools{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}.refresh-button{margin:0;padding:0 28rpx;line-height:64rpx;font-size:25rpx;color:#4d9a83;background:#e8f3ef;border-radius:999rpx}.refresh-button:after{border:0}.resource-count{font-size:24rpx;color:#8a9487}.category-scroll{width:100%;margin:0 0 22rpx;white-space:nowrap}.category-row{display:flex;gap:14rpx}.category-tab{flex:0 0 auto;padding:13rpx 27rpx;border-radius:999rpx;background:#eef2eb;color:#738070;font-size:25rpx}.category-tab.active{background:#4d9a83;color:#fff;font-weight:800}.resource-card{display:flex;align-items:center;gap:20rpx;background:#fff;border-radius:28rpx;padding:24rpx;margin:18rpx 0;box-shadow:0 8rpx 24rpx rgba(87,115,69,.08)}.resource-icon,.resource-image{flex:0 0 auto;width:90rpx;height:90rpx;border-radius:22rpx}.resource-icon{background:#e8f3df;color:#4d9847;display:flex;align-items:center;justify-content:center;font-size:32rpx;font-weight:900}.resource-image{background:#eef6ff}.resource-copy{flex:1;min-width:0}.resource-title{font-size:32rpx;font-weight:900}.resource-meta{font-size:23rpx;color:#7d877a;margin-top:7rpx}.resource-preview{font-size:23rpx;color:#9aa194;margin-top:10rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.resource-arrow{font-size:42rpx;color:#6ea38e}.empty-resource,.empty-category{text-align:center;background:#fff;border-radius:28rpx;padding:58rpx 26rpx}.empty-category{color:#71806f;font-size:28rpx}.empty-category .muted{margin-top:14rpx}.empty-icon{font-size:66rpx}.empty-title{font-size:31rpx;font-weight:900;margin:16rpx 0 8rpx}.empty-resource button{margin-top:28rpx}.waiting{margin-top:26rpx;font-size:25rpx;color:#818a7c}.resource-mask{position:fixed;z-index:1100;inset:0;background:rgba(29,41,32,.48);display:flex;align-items:center;justify-content:center;padding:36rpx}.resource-dialog{box-sizing:border-box;width:100%;max-height:84vh;overflow:auto;background:#fff;border-radius:32rpx;padding:34rpx}.dialog-top{display:flex;align-items:flex-start;justify-content:space-between;gap:22rpx}.dialog-title{font-size:40rpx;font-weight:900}.dialog-meta{font-size:25rpx;color:#7d877a;margin-top:9rpx}.dialog-close{width:58rpx;height:58rpx;border-radius:50%;background:#edf3e9;color:#657064;font-size:42rpx;line-height:54rpx;text-align:center}.resource-text{white-space:pre-wrap;text-align:left;background:#f6f9f3;border-radius:22rpx;padding:30rpx 22rpx;margin:28rpx 0;font-size:29rpx;line-height:1.85;color:#354235}.poem-text{text-align:center;font-size:31rpx;line-height:2}.word-card{background:#eef6ff;border-radius:24rpx;padding:26rpx 22rpx 34rpx;margin:28rpx 0;text-align:center}.word-illustration{display:block;width:100%;border-radius:18rpx;margin:0 auto 28rpx;box-shadow:0 10rpx 24rpx rgba(38,92,143,.16)}.word-translation{font-size:35rpx;font-weight:900;color:#234c75}.word-phonetic{font-size:29rpx;color:#437db1;margin:12rpx 0 28rpx}.word-example{font-size:31rpx;font-weight:700;color:#263c4c}.word-example-translation{font-size:27rpx;color:#71808c;margin-top:12rpx}.template-area{border-top:1rpx solid #edf0e9;padding-top:24rpx}.template-title{font-size:28rpx;font-weight:800}.template-buttons{display:flex;gap:14rpx;margin-top:18rpx}.template-button{flex:1;margin:0;background:#4d9a83;color:#fff;border-radius:999rpx;font-size:26rpx}.template-button:after{border:0}.child-read{color:#7d877a;font-size:26rpx;text-align:center;margin-top:18rpx}
