<view class="page resource-page">
  <view class="eyebrow">统编版 · 三年级上册</view>
  <view class="title">语文必背古诗词</view>
  <view class="intro">选择一首古诗查看全文；爸爸妈妈可将朗读、背诵或默写加入今日打卡。</view>

  <view wx:if="{{ready&&resources.length===0}}" class="empty-resource">
    <view class="empty-icon">📚</view>
    <view class="empty-title">{{resourceError?'资源服务尚未部署':'古诗词资源库尚未初始化'}}</view>
    <view class="muted">{{resourceError?'请先部署 getLearningResources 云函数，再初始化资源库。':'初始化后可创建古诗词打卡任务。'}}</view>
    <button wx:if="{{role==='father'||role==='mother'}}" class="button" bindtap="initResources" loading="{{initializing}}" disabled="{{initializing}}">{{initializing?'加载中':'初始化资源库'}}</button>
    <view wx:else class="waiting">请让爸爸或妈妈先初始化资源库</view>
  </view>

  <view class="resource-card" wx:for="{{resources}}" wx:key="_id" bindtap="openResource" data-id="{{item._id||item.id}}">
    <view class="resource-icon">诗</view>
    <view class="resource-copy">
      <view class="resource-title">{{item.title}}</view>
      <view class="resource-meta">{{item.dynasty}} · {{item.author}} · 第 {{item.unit}} 单元</view>
      <view class="resource-preview">{{item.preview||item.content}}</view>
    </view>
    <view class="resource-arrow">›</view>
  </view>

  <view wx:if="{{resourceVisible}}" class="resource-mask" bindtap="closeResource">
    <view class="resource-dialog" catchtap="stop">
      <view class="dialog-top">
        <view><view class="dialog-title">{{selectedResource.title}}</view><view class="dialog-meta">{{selectedResource.dynasty}} · {{selectedResource.author}}</view></view>
        <view class="dialog-close" bindtap="closeResource">×</view>
      </view>
      <view class="poem-text">{{selectedResource.content}}</view>
      <view wx:if="{{role==='father'||role==='mother'}}" class="template-area">
        <view class="template-title">选择任务类型</view>
        <view class="template-buttons"><button wx:for="{{templates}}" wx:key="*this" class="template-button" data-type="{{item}}" bindtap="createTask" loading="{{creatingType===item}}" disabled="{{creatingType!==''}}">{{item}}</button></view>
      </view>
      <view wx:else class="child-read">背诵完成后，请到“今天”页提交打卡。</view>
    </view>
  </view>
</view>
