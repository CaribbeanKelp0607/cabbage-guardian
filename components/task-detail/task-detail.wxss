.detail-mask{position:fixed;z-index:1200;inset:0;background:rgba(29,41,32,.48);display:flex;align-items:center;justify-content:center;padding:38rpx}.detail-dialog{box-sizing:border-box;width:100%;max-height:82vh;overflow:auto;background:#fff;border-radius:32rpx;padding:34rpx;box-shadow:0 24rpx 70rpx rgba(27,48,34,.22)}.dialog-head{display:flex;justify-content:space-between;align-items:flex-start;gap:24rpx}.dialog-eyebrow{font-size:24rpx;color:#7c806b}.dialog-title{font-size:38rpx;font-weight:900;color:#2f3d32;margin-top:8rpx;word-break:break-all}.close-button{flex:0 0 auto;width:58rpx;height:58rpx;border-radius:50%;background:#eef3eb;color:#657064;font-size:42rpx;line-height:54rpx;text-align:center}.status-card{border-radius:22rpx;padding:22rpx 24rpx;margin:28rpx 0}.status-todo{background:#e8f4e1;color:#4f8f45}.status-submitted{background:#fff1cb;color:#a9731f}.status-done{background:#ddf1e9;color:#367d65}.status-name{font-size:29rpx;font-weight:900}.status-hint{font-size:24rpx;margin-top:7rpx}.detail-section{padding:22rpx 0;border-bottom:1rpx solid #edf0e9}.row-section{display:flex;justify-content:space-between;align-items:flex-start;gap:24rpx}.detail-label{flex:0 0 auto;font-size:25rpx;color:#868d80}.detail-value{font-size:29rpx;color:#344137;line-height:1.6;white-space:pre-wrap;word-break:break-all}.row-section .detail-value{text-align:right}.reward-text{color:#d19026;font-weight:800}.detail-done{margin:30rpx 0 0;background:#4d9a83;color:#fff;border-radius:999rpx;font-size:29rpx;font-weight:800}.detail-done:after{border:0}
.poem-section{padding:22rpx 0;border-bottom:1rpx solid #edf0e9}.poem-meta{color:#7b8578;font-size:25rpx;margin-top:12rpx}.resource-snapshot-image{display:block;width:100%;border-radius:18rpx;margin-top:16rpx}.poem-content{background:#f7f9f4;border-radius:18rpx;padding:22rpx;margin-top:16rpx;color:#354235;font-size:29rpx;line-height:1.9;white-space:pre-wrap;text-align:center}
.evidence-section{padding:22rpx 0;border-bottom:1rpx solid #edf0e9}.evidence-item{margin-top:18rpx;background:#f7f9f4;border-radius:18rpx;padding:18rpx}.evidence-type{font-size:24rpx;color:#63816e;margin-bottom:12rpx}.evidence-image,.evidence-video{display:block;width:100%;border-radius:14rpx;overflow:hidden}.evidence-image{cursor:zoom-in}.evidence-image-hint{margin-top:10rpx;text-align:right;font-size:21rpx;color:#6f927c}.evidence-load-error{padding:22rpx;border-radius:14rpx;background:#fff1e5;color:#ae7440;font-size:23rpx;text-align:center}.evidence-audio{display:block;width:100%}
.upload-section{padding:22rpx 0;border-bottom:1rpx solid #edf0e9}.upload-hint{font-size:24rpx;color:#718071;margin-top:12rpx}.upload-actions{display:flex;gap:12rpx;margin:18rpx 0}.upload-button{flex:1;margin:0;line-height:58rpx;font-size:24rpx;background:#e3f0de;color:#4d8d43;border-radius:999rpx}.upload-button.recording{background:#ffe6e1;color:#b6564b}.upload-button:after{border:0}
