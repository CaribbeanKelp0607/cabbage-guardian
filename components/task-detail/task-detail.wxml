<view wx:if="{{visible}}" class="detail-mask" bindtap="close">
  <view class="detail-dialog" catchtap="stop">
    <view class="dialog-head">
      <view>
        <view class="dialog-eyebrow">任务详情</view>
        <view class="dialog-title">{{task.title}}</view>
      </view>
      <view class="close-button" bindtap="close">×</view>
    </view>

    <view class="status-card status-{{task.status}}">
      <view class="status-name">{{statusText}}</view>
      <view class="status-hint">{{statusHint}}</view>
    </view>

    <view class="detail-section">
      <view class="detail-label">学习要求</view>
      <view class="detail-value">{{task.detail||'暂无学习要求'}}</view>
    </view>
    <view class="detail-section row-section">
      <view class="detail-label">任务日期</view>
      <view class="detail-value">{{dateText}}</view>
    </view>
    <view class="detail-section row-section">
      <view class="detail-label">奖励规则</view>
      <view class="detail-value reward-text">确认后 +1 颗白菜</view>
    </view>

    <button class="detail-done" bindtap="close">我知道了</button>
  </view>
</view>
