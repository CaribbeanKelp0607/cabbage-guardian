<view wx:if="{{visible}}" class="detail-mask" bindtap="close">
  <view class="detail-dialog" catchtap="stop">
    <view class="dialog-head">
      <view>
        <view class="dialog-eyebrow">任务详情</view>
        <view class="dialog-title">{{task.title}}</view>
      </view>
      <view class="close-button" bindtap="close">×</view>
    </view>

    <view class="status-card status-{{task.status}}">
      <view class="status-name">{{statusText}}</view>
      <view class="status-hint">{{statusHint}}</view>
    </view>

    <view class="detail-section">
      <view class="detail-label">学习要求</view>
      <view class="detail-value">{{task.detail||'暂无学习要求'}}</view>
    </view>
    <view class="detail-section row-section">
      <view class="detail-label">任务日期</view>
      <view class="detail-value">{{dateText}}</view>
    </view>
    <view class="detail-section row-section">
      <view class="detail-label">奖励规则</view>
      <view class="detail-value reward-text">完成打卡后可选择种下 1 颗蔬菜</view>
    </view>
    <view wx:if="{{task.resourceSnapshot}}" class="poem-section">
      <view class="detail-label">学习资源</view>
      <view wx:if="{{task.resourceSnapshot.author}}" class="poem-meta">{{task.resourceSnapshot.dynasty}} · {{task.resourceSnapshot.author}}</view>
      <image wx:if="{{task.resourceSnapshot.image}}" class="resource-snapshot-image" src="{{task.resourceSnapshot.image}}" mode="widthFix" />
      <view class="poem-content">{{task.resourceSnapshot.content}}</view>
      <button wx:for="{{pronunciationWords}}" wx:key="*this" class="evidence-audio" data-word="{{item}}" bindtap="playPronunciation" loading="{{resolvingFileId==='pronunciation:'+item}}">{{playingFileId==='pronunciation:'+item?'■ 停止播放':'▶ 听单词读音'}} · {{item}}</button>
    </view>
    <view wx:if="{{evidenceItems.length}}" class="evidence-section">
      <view class="detail-label">打卡凭证</view>
      <view wx:for="{{evidenceItems}}" wx:key="fileID" class="evidence-item">
        <view class="evidence-type">{{item.type==='image'?'图片':item.type==='audio'?'录音':'视频'}}</view>
        <image wx:if="{{item.type==='image'&&item.fileURL}}" class="evidence-image" src="{{item.fileURL}}" mode="widthFix" data-file-id="{{item.fileID}}" bindtap="previewEvidenceImage"/>
        <view wx:if="{{item.type==='image'&&item.fileURL}}" class="evidence-image-hint">点击图片可放大查看</view>
        <button wx:if="{{item.type==='audio'&&!item.loadError}}" class="evidence-audio" data-file-id="{{item.fileID}}" bindtap="playAudio" loading="{{resolvingFileId===item.fileID}}" style="margin:0;width:100%;background:#e3f0de;color:#4d8d43;border-radius:16rpx;font-size:27rpx;">{{playingFileId===item.fileID?'停止播放':'▶ 播放录音'}}</button>
        <video wx:if="{{item.type==='video'&&item.fileURL}}" class="evidence-video" src="{{item.fileURL}}" controls object-fit="contain"/>
        <view wx:if="{{item.loadError}}" class="evidence-load-error">
          <view>{{item.loadErrorMessage||'该凭证暂时无法加载'}}</view>
          <button class="evidence-retry" data-file-id="{{item.fileID}}" bindtap="retryEvidence">重新加载</button>
        </view>
      </view>
    </view>
    <view wx:if="{{role==='child'&&task.status!=='done'&&canCheckin}}" class="upload-section">
      <view class="detail-label">上传打卡凭证</view>
      <view class="upload-hint">上传图片、录音或视频中的任一种后，将自动完成打卡</view>
      <view class="upload-actions">
        <button class="upload-button" bindtap="chooseImage" disabled="{{uploadingTaskId!==''||recordingTaskId!==''}}">图片</button>
        <button wx:if="{{recordingTaskId===task.id}}" class="upload-button recording" bindtap="stopRecording">停止录音</button>
        <button wx:else class="upload-button" bindtap="startRecording" disabled="{{uploadingTaskId!==''||recordingTaskId!==''}}">录音</button>
        <button class="upload-button" bindtap="chooseVideo" disabled="{{uploadingTaskId!==''||recordingTaskId!==''}}">视频</button>
      </view>
      <view wx:if="{{uploadingTaskId===task.id}}" class="upload-hint">正在上传凭证…</view>
    </view>
    <view wx:if="{{role==='child'&&task.status!=='done'&&!canCheckin}}" class="upload-section">
      <view class="upload-hint">这是未来任务，将在任务日期当天开放打卡。</view>
    </view>

    <button class="detail-done" bindtap="close">我知道了</button>
  </view>
</view>
